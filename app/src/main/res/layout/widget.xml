<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/panel" android:padding="16dp">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="APP NOTIFY" android:textColor="@color/blue" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetText" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:maxLines="8" android:text="Tap to refresh"
        android:textColor="@color/navy" android:textSize="14sp" />
    <Chronometer android:id="@+id/widgetCountdown" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone"
        android:textColor="@color/navy" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetUpdated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Not updated yet" android:textColor="@color/muted" android:textSize="11sp" />
</LinearLayout>
