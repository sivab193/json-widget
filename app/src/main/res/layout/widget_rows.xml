<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/panel" android:padding="14dp">
    <TextView android:id="@+id/widgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/blue" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp">
        <TextView android:id="@+id/headLeft" style="@style/WidgetHead" android:layout_weight="1" />
        <TextView android:id="@+id/headMain" style="@style/WidgetHead" android:layout_weight="2" />
        <TextView android:id="@+id/headRight" style="@style/WidgetHead" android:layout_weight="1" android:gravity="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:background="#338094A8" />
    <LinearLayout android:id="@+id/row1" style="@style/WidgetRow">
        <TextView android:id="@+id/left1" style="@style/WidgetCellStrong" android:layout_weight="1" />
        <TextView android:id="@+id/main1" style="@style/WidgetCell" android:layout_weight="2" />
        <TextView android:id="@+id/right1" style="@style/WidgetCell" android:layout_weight="1" android:gravity="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" style="@style/WidgetRow">
        <TextView android:id="@+id/left2" style="@style/WidgetCellStrong" android:layout_weight="1" />
        <TextView android:id="@+id/main2" style="@style/WidgetCell" android:layout_weight="2" />
        <TextView android:id="@+id/right2" style="@style/WidgetCell" android:layout_weight="1" android:gravity="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" style="@style/WidgetRow">
        <TextView android:id="@+id/left3" style="@style/WidgetCellStrong" android:layout_weight="1" />
        <TextView android:id="@+id/main3" style="@style/WidgetCell" android:layout_weight="2" />
        <TextView android:id="@+id/right3" style="@style/WidgetCell" android:layout_weight="1" android:gravity="end" />
    </LinearLayout>
    <TextView android:id="@+id/widgetUpdated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="10sp" />
</LinearLayout>
